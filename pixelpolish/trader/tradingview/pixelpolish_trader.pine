//@version=6
// PixelPolish Трейдер — зеркало облачного бумажного агента (paper_trader.py).
// Та же математика: SMA24/168 или RSI14 (30/70), капитал $1000, комиссия 0.1%, всегда весь депозит.
// График: BTCUSD или ETHUSD, таймфрейм 1 час — тогда сигналы совпадают с облаком один в один.
strategy("PixelPolish Трейдер (бумага)", overlay = true,
     initial_capital = 1000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.1)

mode    = input.string("SMA", "Стратегия", options = ["SMA", "RSI"])
fastLen = input.int(24,  "SMA быстрая (часов)")
slowLen = input.int(168, "SMA медленная (часов)")
rsiLen  = input.int(14,  "RSI период")
rsiBuy  = input.int(30,  "RSI: покупка ниже")
rsiSell = input.int(70,  "RSI: продажа выше")

fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)
r    = ta.rsi(close, rsiLen)

plot(fast, "SMA быстрая", color.orange)
plot(slow, "SMA медленная", color.blue)

if mode == "SMA"
    if fast > slow and strategy.position_size == 0
        strategy.entry("long", strategy.long)
    if fast < slow and strategy.position_size > 0
        strategy.close("long")
else
    if r < rsiBuy and strategy.position_size == 0
        strategy.entry("long", strategy.long)
    if r > rsiSell and strategy.position_size > 0
        strategy.close("long")

bgcolor(strategy.position_size > 0 ? color.new(color.green, 92) : na)
